ENV=prod
DJANGO_SETTINGS_MODULE=app.settings.prod
DJANGO_SECRET_KEY=replace-me
ALLOWED_HOSTS=pngpoint.com,www.pngpoint.com

# Database
POSTGRES_DB=pngpoint
POSTGRES_USER=pngpoint
POSTGRES_PASSWORD=replace-db-password
POSTGRES_HOST=replace-db-host
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# Redis / Celery (points to the redis stack running in srv/redis)
CELERY_BROKER_URL=redis://:replace-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-redis-password@redis:6379/0

# Frontend coordination
FRONTEND_DOMAIN=https://pngpoint.com
NEXTJS_URL=https://pngpoint.com
REVALIDATE_SECRET=replace-nextjs-secret

# Email (optional override if you change the defaults in settings/base.py)
EMAIL_HOST_USER=replace-email@example.com
EMAIL_HOST_PASSWORD=replace-email-password
